	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>batzorigt.rentsen</groupId>
	<artifactId>rest-api-template</artifactId>
	<version>1.0.0</version>

	<properties>
		<encoding>UTF-8</encoding>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<ebean.version>17.6.0</ebean.version>
		<ebean-plugin.version>17.6.0</ebean-plugin.version>
		<javalin.version>7.2.0</javalin.version>
		<jte.version>3.2.4</jte.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<lombok.version>1.18.46</lombok.version>
		<ebean-migration.version>14.3.0</ebean-migration.version>
		<mockito.version>5.23.0</mockito.version>
	</properties>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<excludes>
				    <exclude>dbmigration/**</exclude>
					<exclude>jte/**</exclude>
					<exclude>**/.DS_Store/**</exclude>
					<exclude>**/.gitignore/**</exclude>
				</excludes>
			</resource>
		</resources>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
				<configuration>
                    <!-- Use the project encoding property to avoid platform-dependent builds -->
                    <encoding>${project.build.sourceEncoding}</encoding>
					<source>25</source>
					<target>25</target>
					<excludes>
						<exclude>dbmigration/**</exclude>
						<exclude>rest/api/GenerateDbMigration.java</exclude>
						<exclude>jte/**</exclude>
						<exclude>**/.DS_Store/**</exclude>
						<exclude>**/.gitignore/**</exclude>
					</excludes>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${mapstruct.version}</version>
						</path>
						<path>
							<groupId>io.ebean</groupId>
							<artifactId>querybean-generator</artifactId>
							<version>${ebean.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.5.0</version>
				<configuration>
					<archive>
					<manifest>
						<addClasspath>true</addClasspath>
						<classpathPrefix>lib/</classpathPrefix>
						<mainClass>rest.api.API</mainClass>
					</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.10.0</version>
				<executions>
					<execution>
					<id>copy-dependencies</id>
					<phase>package</phase>
					<goals>
						<goal>copy-dependencies</goal>
					</goals>
					<configuration>
						<outputDirectory>${project.build.directory}/lib</outputDirectory>
						<includeScope>runtime</includeScope>
					</configuration>
					</execution>
					<execution>
						<id>copy-ebean-agent-to-jib</id>
						<phase>package</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<overWriteIfNewer>false</overWriteIfNewer>
							<artifactItems>
								<artifactItem>
									<groupId>io.ebean</groupId>
									<artifactId>ebean-agent</artifactId>
									<version>${ebean.version}</version>
									<type>jar</type>
									<outputDirectory>${project.basedir}/src/main/jib</outputDirectory>
									<destFileName>ebean-agent-${ebean.version}.jar</destFileName>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
				</plugin>
