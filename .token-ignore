# Token context rules - single source of truth
# Edit this file, then run scripts/sync-token-ignore.ps1 (Windows) or scripts/sync-token-ignore.sh (Linux/macOS).

# [automatic-index-exclude]
# Exclude these from broad context indexing. Agents may read them explicitly when a task requires it.
.github
.mvn
.opencode
.settings
.vscode
.idea
.ai-loop/

# [never-read]
# Generated artifacts and dependencies contain no source context. Agents must not read them.
target
jte-classes
src/main/jib
app-cds.jsa
node_modules
**/query/Q*.java
